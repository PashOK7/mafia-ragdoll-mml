+struct CarSeatSlot {
+    V3 origin; // vehicle-local root position of the native sitting animation
+    uint8_t usable;
+    uint8_t door;
+    uint16_t reserved;
+    void *owner;
+    uint8_t other[0x8C];
+};
+static_assert(sizeof(CarSeatSlot) == 0xA0);
+
+inline const CarSeatSlot *CarSeats(void *car, int *count) {
+    const auto begin = at<uintptr_t>(car, Exe().carSeatSlots);
+    const auto end = at<uintptr_t>(car, Exe().carSeatSlots + sizeof(uintptr_t));
+    *count = begin && end >= begin && end - begin <= 8 * sizeof(CarSeatSlot) &&
+             (end - begin) % sizeof(CarSeatSlot) == 0
+        ? static_cast<int>((end - begin) / sizeof(CarSeatSlot)) : 0;
+    return reinterpret_cast<const CarSeatSlot *>(begin);
+}
+
+inline bool SetCarSeatOwner(void *car, void *human, int seat, float mass) {
+    using Fn = bool(__thiscall *)(void *, void *, int, float);
+    return reinterpret_cast<Fn>(Exe().carSetSeatOwner)(car, human, seat, mass);
+}
+
+inline void ForceExitCar(void *human) {
+    using Fn = void(__thiscall *)(void *);
+    reinterpret_cast<Fn>(Exe().humanForceExitCar)(human);
+}

