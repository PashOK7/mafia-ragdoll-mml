+// C_dog::Hit uses this same mission gore gate and the native blood manager.
+// Verified call sites: 1.2 435546 and 1.0 47C076. Velocity is in m/s.
+inline bool EmitBloodImpact(const V3 &point,const V3 &velocity,float amount) {
+    void *mission=Mission(), *game=Game();
+    if (!mission || !game || at<int>(mission,0x9c)<=0 || !(amount>0.f)) return false;
+    using AddBlood=void *(__thiscall *)(void *,const V3 *,const V3 *,float,int,int);
+    const auto add=reinterpret_cast<AddBlood>(Exe().bloodAdd);
+    return add(static_cast<uint8_t *>(game)+0x2d90,&point,&velocity,amount,0,0)!=nullptr;
+}
+
+}
