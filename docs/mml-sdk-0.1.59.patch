 // or more hurts him (a hit of type 6, (speed - 2) * 10).
 constexpr int kHumanFallSpeed = 0x418, kHumanStateAir = 3;
+// humanActions dispatches to MovementIntern in these states. Other states can still move
+// the actor through animation tracks, so its rendered or native position is not a velocity source.
+constexpr int kHumanStateStand = 1, kHumanStateMove = 2, kHumanStateRunJump = 11;
+constexpr int kHumanMoveVector = 0x420, kHumanPreviousMoveVector = 0x430, kHumanMoveBlend = 0x43C;
 // PersonAnim (1.2 0x573E50, 1.0 0x4942C0) stores the sampled end-of-track lift at this +0x1DC.
 // Disassembly: EBP=this+0xBC, FSTP [EBP+0x120]. A physical body's get-up must not climb that remote sample.
 constexpr int kHumanTrackLift = 0x1DC;
@@ -113,6 +117,18 @@ constexpr int kGameShots = 0x1D8, kShotSize = 0x5C, kShotFrom = 0x00, kShotWay =

 template <class T> inline T &at(void *p, int off) { return *reinterpret_cast<T *>(reinterpret_cast<uint8_t *>(p) + off); }

+inline V3 HumanMovementVelocity(void *human, int state) {
+    if (state != kHumanStateStand && state != kHumanStateMove &&
+        state != kHumanStateAir && state != kHumanStateRunJump) return {};
+    V3 v = at<V3>(human, kHumanMoveVector);
+    // MovementIntern uses the decaying previous input after a locomotion input has ended.
+    if (Dot(v, v) < 1e-16f)
+        v = at<V3>(human, kHumanPreviousMoveVector) * at<float>(human, kHumanMoveBlend);
+    if (state == kHumanStateAir || state == kHumanStateRunJump)
+        v.y -= at<float>(human, kHumanFallSpeed);
+    return v;
+}
